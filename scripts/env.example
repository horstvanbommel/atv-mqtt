# Copy this file to ".env" (same directory as atv_mqtt_bridge.py) and fill in
# real values. ".env" itself is gitignored and must never be committed.

MQTT_BROKER=192.168.50.2
MQTT_PORT=1883
MQTT_USER=mqtt_user
MQTT_PW=changeme

# Pairing credentials obtained via:
#   atvremote --id <ID> --protocol companion pair
#   atvremote --id <ID> --protocol airplay pair
ATV_WOHNZIMMER_ID=8E99280BFB01
ATV_WOHNZIMMER_COMPANION=
ATV_WOHNZIMMER_AIRPLAY=

